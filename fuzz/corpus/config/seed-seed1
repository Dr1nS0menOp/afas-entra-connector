# afas-entra-sync — example configuration
# Unknown keys are rejected: a typo gives an error, not a silent default value.
# Field names (Personeelsnummer, Roepnaam …) are the AFAS GetConnector field names; adjust them to yours.

[afas]
base_url = "https://12345.rest.afas.online/ProfitRestServices"
connector = "Entra_Medewerkers"          # GetConnector, one row per employee
token_env = "AFAS_TOKEN"                 # or: token_file = "/etc/afas-entra-sync/afas.token"
page_size = 1000                         # rows per page (1..10000)
order_by_field = "Personeelsnummer"      # unique field: stable paging
timeout_secs = 120
max_attempts = 4

# Field names as they are called in the GetConnector. Optional fields can be left out.
[afas.fields]
employee_id = "Personeelsnummer"
given_name = "Roepnaam"
name_prefix = "Voorvoegsel"
family_name = "Achternaam"
upn = "UPN"                              # UPN generated by AFAS (leading, also for the group sync)
email = "EmailWerk"
job_title = "Functie"
department = "Afdeling"
manager_id = "PersoneelsnummerLeidinggevende"
cost_center = "Kostenplaats"
start_date = "DatumInDienst"
end_date = "DatumUitDienst"

# Extra attributes, each with an on/off toggle. Off = not read and not sent
# (the value in AD then stays, unless "clear attribute values" is on).
# Leaving out this whole section = everything off.
[afas.fields.extra]
phone_work    = { enabled = true,  field = "TelefoonWerk" }        # -> telephoneNumber
phone_mobile  = { enabled = false, field = "MobielWerk" }          # -> custom extension mobilePhone
office        = { enabled = true,  field = "Standplaats" }         # -> custom extension officeLocation
company       = { enabled = true,  field = "Werkgever" }           # -> organization (company)
employee_type = { enabled = false, field = "SoortMedewerker" }     # -> userType (employeeType)
job_profile   = { enabled = false, field = "Functieprofiel" }      # -> custom extension jobProfile
street        = { enabled = false, field = "StraatWerk" }          # -> streetAddress
postal_code   = { enabled = false, field = "PostcodeWerk" }        # -> postalCode
city          = { enabled = false, field = "PlaatsWerk" }          # -> l
country       = { enabled = false, field = "LandWerk" }            # -> c (2 letters, e.g. NL)
send_hire_date  = false                                            # -> custom extension hireDate
send_leave_date = false                                            # -> custom extension leaveDate

[entra]
tenant_id = "00000000-0000-0000-0000-000000000000"
client_id = "00000000-0000-0000-0000-000000000000"
auth = "certificate"                     # or "client_secret" with client_secret_env
certificate_pem = "/etc/afas-entra-sync/cert.pem"
private_key_pem = "/etc/afas-entra-sync/key.pem"
service_principal_id = "00000000-0000-0000-0000-000000000000"
job_id = "API2AD.00000000000000000000000000000000.00000000-0000-0000-0000-000000000000"

[policy]
timezone = "Europe/Amsterdam"
allowed_upn_domains = ["example.com"]
prehire_days = 14            # new hires (pre-hires): create the disabled account this many days before the start date
leaver_lookback_days = 30    # keep sending departing employees (leavers) as 'disabled' this many days after their end date
min_records = 50             # fewer to send = stop
max_drop_percent = 10        # drop vs. the last successful run larger than this = stop
max_disables_per_run = 10    # more new disables = stop (to proceed: --allow-mass-disable)
max_invalid_percent = 5      # more invalid records = stop (points to a mapping error)
max_calls_per_run = 200      # Entra P1 allows 2,000 calls per 24 hours

[upload]
batch_size = 50              # Microsoft maximum
pace_ms = 250                # Microsoft limit: 40 calls per 5 s
max_attempts = 6
backoff_base_ms = 2000
backoff_max_ms = 60000
bucket_full_wait_secs = 300
max_retry_after_secs = 600

[state]
dir = "/var/lib/afas-entra-sync"

# Staff category (population). Leave out for the regular employee config; for contractors/externals/interns
# use a separate config (own connector, own state.dir) with for example:
# [population]                # staff category
# name = "contractors"
# id_prefix = "CTR-"
# employee_type = "Contractor"

# TLS for AFAS, Entra login and Graph. Check what is negotiated with: check-tls
[tls]
min_version = "1.3"          # "1.3" (default) or "1.2"
post_quantum = "prefer"      # "prefer" (default) or "require" (refuses servers without ML-KEM)

# Admin GUI. Off by default; can only be turned on here.
[gui]
enabled = false

# ---------------------------------------------------------------------------------------
# Optional modules. They run after a successful provisioning upload, each with its own
# app registration (certificate auth), its own maximum per run and the same dry-run:
# without --apply they only plan. See docs/MODULES.md for permissions and behaviour.
# ---------------------------------------------------------------------------------------

# Roles and licences: group membership from HR data. Assign licences to these groups
# (group-based licensing). Permissions: GroupMember.ReadWrite.All, User.Read.All.
# [roles]
# enabled = true
# client_id = "00000000-0000-0000-0000-000000000000"
# certificate_pem = "/etc/afas-entra-sync/roles-cert.pem"
# private_key_pem = "/etc/afas-entra-sync/roles-key.pem"
# group_prefix = "AFAS-"            # every managed group must start with this
# include_prehires = false          # true = groups (and licences) before the start date
# keep_leavers_days = 0             # keep departing employees (leavers) in their groups this many days
# remove_unknown_members = false    # leave admin/service accounts in managed groups alone
# max_changes_per_run = 50
#
# [[roles.rule]]                    # all non-empty criteria must match; values are OR
# group_id = "11111111-1111-1111-1111-111111111111"
# name = "AFAS-M365-E3"
# all = true                        # everyone in this upload
#
# [[roles.rule]]
# group_id = "22222222-2222-2222-2222-222222222222"
# name = "AFAS-Finance"
# department = ["Finance", "Control"]
#
# [[roles.rule]]
# group_id = "33333333-3333-3333-3333-333333333333"
# name = "AFAS-Payments"
# job_profile = ["PAYMENTS"]
#
# [[roles.sod]]                     # never give these groups to one person
# name = "Pay and approve"
# groups = ["22222222-2222-2222-2222-222222222222", "33333333-3333-3333-3333-333333333333"]

# New hires (joiners): first sign-in code (Temporary Access Pass), mailed to the manager.
# Permissions: UserAuthMethod-TAP.ReadWrite.All, User.Read.All, and Mail.Send scoped to
# the sender mailbox with Exchange RBAC for Applications (see docs/MODULES.md).
# [joiner]
# enabled = true
# client_id = "00000000-0000-0000-0000-000000000000"
# certificate_pem = "/etc/afas-entra-sync/joiner-cert.pem"
# private_key_pem = "/etc/afas-entra-sync/joiner-key.pem"
# sender = "onboarding@example.com"
# deliver_to = "manager"            # or "fixed"
# fixed_address = "servicedesk@example.com"   # required with "fixed"; fallback otherwise
# days_before_start = 1
# start_hour = 6                    # pass works from this hour on the start date
# lifetime_minutes = 600            # 10 to 43200
# usable_once = false
# max_per_run = 20

# Departing employees (leavers): sign out on every device and set an automatic reply
# after the end date.
# Permissions: User.RevokeSessions.All, User.Read.All, MailboxSettings.ReadWrite.
# [leaver]
# enabled = true
# client_id = "00000000-0000-0000-0000-000000000000"
# certificate_pem = "/etc/afas-entra-sync/leaver-cert.pem"
# private_key_pem = "/etc/afas-entra-sync/leaver-key.pem"
# revoke_sessions = true
# auto_reply = "{display_name} no longer works here. Please contact {manager_name} ({manager_email})."
# auto_reply_external = false
# grace_days = 7
# max_per_run = 10

# Webhook: signed events for new hires (joiner), job changes (mover) and departing
# employees (leaver), for an ITSM tool or Power Automate.
# [webhook]
# enabled = true
# url = "https://itsm.example.com/hooks/afas"
# secret_env = "AFAS_ENTRA_WEBHOOK_SECRET"    # or secret_file (mode 0600), at least 16 characters
# events = ["joiner", "mover", "leaver"]
# timeout_secs = 15
# max_per_run = 200
