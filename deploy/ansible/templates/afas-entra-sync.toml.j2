# afas-entra-sync — managed by Ansible (deploy/ansible)
# Unknown keys are rejected: a typo gives an error, not a silent default value.
# Field names are the AFAS GetConnector field names.

[afas]
base_url = "https://{{ afas_env }}.rest.afas.online/ProfitRestServices"
connector = "{{ afas_connector }}"     # GetConnector, one row per employee
token_file = "/etc/afas-entra-sync/afas.token"
page_size = 1000                         # rows per page (1..10000)
order_by_field = "Personeelsnummer"      # unique field: stable paging
timeout_secs = 120
max_attempts = 4

# Field names as they are called in the GetConnector. Optional fields can be left out.
[afas.fields]
employee_id = "Personeelsnummer"
given_name = "Roepnaam"
name_prefix = "Voorvoegsel"
family_name = "Achternaam"
upn = "UPN"                              # UPN generated by AFAS (leading, also for the group sync)
email = "EmailWerk"
job_title = "Functie"
department = "Afdeling"
manager_id = "PersoneelsnummerLeidinggevende"
cost_center = "Kostenplaats"
start_date = "DatumInDienst"
end_date = "DatumUitDienst"

[entra]
tenant_id = "{{ tenant_id }}"
client_id = "{{ client_id }}"
auth = "certificate"                     # or "client_secret" with client_secret_env
certificate_pem = "/etc/afas-entra-sync/cert.pem"
private_key_pem = "/etc/afas-entra-sync/key.pem"
service_principal_id = "{{ sp_id }}"
job_id = "{{ job_id }}"

[policy]
timezone = "Europe/Amsterdam"
allowed_upn_domains = ["{{ upn_domain }}"]
prehire_days = 14            # create the (disabled) account this many days before the start date
leaver_lookback_days = 30    # keep sending leavers as 'disabled' this many days after their end date
min_records = {{ (employee_count * 0.9) | int }}             # fewer to send = stop
max_drop_percent = 10        # drop vs. the last successful run larger than this = stop
max_disables_per_run = 10    # more new disables = stop (to proceed: --allow-mass-disable)
max_invalid_percent = 5      # more invalid records = stop (points to a mapping error)
max_calls_per_run = 200      # Entra P1 allows 2,000 calls per 24 hours

[upload]
batch_size = 50              # Microsoft maximum
pace_ms = 250                # Microsoft limit: 40 calls per 5 s
max_attempts = 6
backoff_base_ms = 2000
backoff_max_ms = 60000
bucket_full_wait_secs = 300
max_retry_after_secs = 600

[state]
dir = "/var/lib/afas-entra-sync"

# TLS for AFAS, Entra login and Graph. Check with: afas-entra-sync -c <config> check-tls
[tls]
min_version = "{{ tls_min_version | default('1.3') }}"       # "1.3" or "1.2"
post_quantum = "{{ tls_post_quantum | default('prefer') }}"  # "prefer" or "require"

# Admin GUI: can only be turned on here (gui_enabled: true in vars).
[gui]
enabled = {{ (gui_enabled | default(false)) | bool | lower }}
